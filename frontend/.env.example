# OpenHive dashboard — Supabase read access (anon key, public by design).
# On Vercel, add these under Project Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: your live backend URL, shown in the header.
NEXT_PUBLIC_BACKEND_URL=https://openhive-backend.onrender.com
