# OpenHive environment configuration.
# Copy this file to .env and fill in the values. .env is gitignored.

# --- Claude (Phase 1) ---
# Anthropic API key. Powers every agent's reasoning (Triage, PR Review,
# Security, and later Docs/Health). Used by the anthropic SDK.
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- GitHub Models / observability tracing (Phase 1) ---
# A GitHub PAT used by the GitHub Models endpoint (OpenAI-compatible) to emit a
# per-call observability trace. This is OpenHive's Microsoft-stack integration.
GITHUB_TOKEN=your_github_token_here
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference

# --- GitHub repo writes (Phase 3) ---
# A GitHub PAT used by PyGitHub to post comments, open patch PRs, and apply
# labels back to repositories. Kept separate from GITHUB_TOKEN so the two can be
# scoped and rotated independently. Needs 'repo' (classic) or Issues+PR write
# (fine-grained) on the target repos.
GITHUB_TOKEN_REPO=your_github_pat_here

# --- GitHub webhook (Phase 1) ---
# Shared secret used to verify the X-Hub-Signature-256 HMAC on every incoming
# webhook. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# --- GitHub App (reserved, not yet used) ---
# Placeholders for a future GitHub App auth path. OpenHive currently uses a PAT
# (GITHUB_TOKEN_REPO) + webhook, so these are unset for now.
GITHUB_APP_ID=your_github_app_id_here
GITHUB_PRIVATE_KEY_PATH=./github-app-private-key.pem

# --- Supabase persistence (Phase 4) ---
# Project URL and anon public key for the agent_verdicts table. Every agent
# verdict is written here (via backend/persistence.py) BEFORE any GitHub write,
# guaranteeing auditability. RLS must be disabled (or a permissive policy added)
# so the anon key can insert.
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# --- Runtime (Phase 1) ---
# Deployment environment tag. 'local' for development; set per host on deploy
# (backend target is Render, frontend is Vercel).
APP_ENV=local
